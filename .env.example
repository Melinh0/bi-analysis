APP_NAME="BI Analysis"
APP_VERSION="0.2.0"
DEBUG=true

DATABASE_URL="sqlite:///./data/bi_analysis.db"
VECTOR_STORE_PATH="./data/vector_store"

OLLAMA_API_KEY="your-ollama-api-key-here"
OLLAMA_BASE_URL="https://api.ollama.com"
OLLAMA_MODEL="nemotron-3-ultra"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"
OLLAMA_AVAILABLE_MODELS="gemma4:cloud,gpt-oss:120b,nemotron-3-ultra"

INSTAGRAM_EMAIL="your-instagram-email"
INSTAGRAM_PASSWORD="your-instagram-password"
INSTAGRAM_API_EMAIL="your-instagram-api-email"
INSTAGRAM_API_PASSWORD="your-instagram-api-password"

CHROMA_COLLECTION_NAME="bi_analysis_documents"
EMBEDDING_BATCH_SIZE=100
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5

WEB_HOST="0.0.0.0"
WEB_PORT=8000

LOG_LEVEL="INFO"